{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mailflare",
	"account_id": "c79518eee7696d23795de5184c4bbc01",
	// Keep first-admin registration private until onboarding is complete.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "mail.calibercode.io",
			"custom_domain": true,
		},
	],
	"vars": {
		"CF_AID": "c79518eee7696d23795de5184c4bbc01",
		"CF_EMAIL_WORKER_NAME": "mailflare",
		"D1_DATABASE_ID": "a9443977-88d2-46c1-bdc4-052784b445e8",
	},
	"main": "./worker.ts",
	"compatibility_date": "2026-05-20",
	"keep_vars": true,
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets",
	},
	"images": {
		"binding": "IMAGES",
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "mailflare",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "REALTIME",
				"class_name": "RealtimeHub",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RealtimeHub",
			],
		},
	],
	"workflows": [
		{
			"name": "mailflare-database-backup",
			"binding": "DATABASE_BACKUP_WORKFLOW",
			"class_name": "DatabaseBackupWorkflow",
			// Enable a schedule after configuring a D1 export token.
		},
	],
	"ratelimits": [
		{
			"name": "LOGIN_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60,
			},
		},
	],
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true,
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mailflare",
			"database_id": "a9443977-88d2-46c1-bdc4-052784b445e8",
			"migrations_dir": "drizzle/migrations",
		},
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "mailflare-raw",
		},
	],
	"queues": {
		"producers": [
			{
				"binding": "INBOUND_QUEUE",
				"queue": "mailflare-inbound",
			},
			{
				"binding": "OUTBOUND_QUEUE",
				"queue": "mailflare-outbound",
			},
		],
		"consumers": [
			{
				"queue": "mailflare-inbound",
				"max_batch_size": 5,
				"max_retries": 3,
			},
			{
				"queue": "mailflare-outbound",
				"max_batch_size": 5,
				"max_retries": 3,
			},
		],
	},
}
